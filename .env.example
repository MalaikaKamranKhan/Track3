# Copy to .env and fill in. Never commit .env.

BOT_NAME=Squad
# The public https address of this server (what the Cubbie Skill calls). Example: https://squad-xyz.trycloudflare.com
PUBLIC_URL=http://localhost:8000
PORT=8000

# Chat apps: set one or both
DISCORD_TOKEN=
# Your test server's ID: slash commands show up instantly there (right-click server > Copy Server ID)
DISCORD_GUILD_ID=
TELEGRAM_TOKEN=

# AI: fake (offline demo) | gemini | anthropic | openai | bedrock
LLM_PROVIDER=fake
# Leave empty for the default model of the provider
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# bedrock uses normal AWS credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) and this region
AWS_REGION=us-east-1

# Game tuning
QUESTIONS_PER_BATTLE=5
QUESTION_SECONDS=25
NUDGE_COOLDOWN_MINUTES=30

# Extra game tuning (optional)
LIE_SECONDS=30
WAGER_SECONDS=12
EXPLAIN_ROUNDS=3
EXPLAIN_SECONDS=75
OPEN_FLOOR_SECONDS=45
# How long a scheduled Daily Duel stays open (seconds), and one started by hand with /daily
DAILY_SECONDS=1800
DAILY_NOW_SECONDS=90
